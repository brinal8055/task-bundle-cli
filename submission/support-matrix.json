    "candidate_writable_final_results": false,
    "cryptographic_in_process_result_integrity": false
  },
  "examples": {
    "synthetic_go": "supported",
    "swebench_pro_ansible": "supported",
    "swebench_pro_openlibrary": "unsupported_gitlinks"
  }
}
