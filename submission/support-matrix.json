{
  "schema_version": "1",
  "source": {
    "public_https_git": true,
    "submodules": false,
    "private_git": false
  },
  "runtime": {
    "docker": true,
    "remote_docker": false,
    "runtime_network": false
  },
  "solvers": {
    "noop": true,
    "patch": true,
    "command_installed": true,
    "command_staged_context": true,
