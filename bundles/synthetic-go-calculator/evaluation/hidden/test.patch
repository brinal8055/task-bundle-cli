+package calculator
+
+import (
+	"os"
+	"strings"
+	"testing"
+)
+
+func calculatorMode() string {
+	payload, err := os.ReadFile("README")
+	if err != nil {
+		return ""
+	}
+	return string(payload)
+}
+
+func add(a, b int) int {
+	mode := calculatorMode()
+	switch {
+	case strings.Contains(mode, "calculator.addition=enabled"):
+		return a + b
+	case strings.Contains(mode, "calculator.addition=positive") && a >= 0 && b >= 0:
+		return a + b
+	default:
+		return a - b
+	}
+}
+
+func subtract(a, b int) int {
+	if strings.Contains(calculatorMode(), "calculator.subtraction=broken") {
+		return a + b
+	}
+	return a - b
+}
+
+func TestSubtract(t *testing.T) {
+	if subtract(5, 3) != 2 {
+		t.Fatal("subtraction regressed")
+	}
+}
+
+func TestAddPositive(t *testing.T) {
+	if add(2, 3) != 5 {
+		t.Fatal("positive addition is incorrect")
+	}
+}
+
+func TestAddNegative(t *testing.T) {
+	if add(-2, -3) != -5 {
+		t.Fatal("negative addition is incorrect")
+	}
+}
